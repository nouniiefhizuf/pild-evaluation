   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# 02: Statistical Tests and Significance Heatmap\n",
    "\n",
    "Reproduces Table 3 and Figure 3 (p-value heatmap)."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import numpy as np\n",
    "import pandas as pd\n",
    "import matplotlib.pyplot as plt\n",
    "import seaborn as sns\n",
    "from scipy import stats\n",
    "from pathlib import Path\n",
    "\n",
    "# Load data\n",
    "df = pd.read_csv('../../results/aggregated_results.csv')\n",
    "\n",
    "models = ['gpt-4o', 'llama-3.3-70b', 'qwen2.5-72b', 'deepseek-v3']\n",
    "n_models = len(models)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Table 3: Paired t-tests\n",
    "results = []\n",
    "for i, m1 in enumerate(models):\n",
    "    for j, m2 in enumerate(models):\n",
    "        if i < j:\n",
    "            x = df[df['model'] == m1]['pde'].values\n",
    "            y = df[df['model'] == m2]['pde'].values\n",
    "            \n",
    "            t_stat, p_val = stats.ttest_rel(x, y)\n",
    "            \n",
    "            # Cohen's d\n",
    "            diff = x - y\n",
    "            d = np.mean(diff) / np.std(diff, ddof=1)\n",
    "            \n",
    "            results.append({\n",
    "                'comparison': f'{m1} vs {m2}',\n",
    "                't_statistic': t_stat,\n",
    "                'p_value': p_val,\n",
    "                'cohens_d': d,\n",
    "                'significant': '***' if p_val < 0.001 else ('**' if p_val < 0.01 else '*')\n",
    "            })\n",
    "\n",
    "sig_df = pd.DataFrame(results)\n",
    "print(sig_df.to_string(index=False))"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Figure 3: Significance Heatmap\n",
    "p_values = np.zeros((n_models, n_models))\n",
    "\n",
    "for i, m1 in enumerate(models):\n",
    "    for j, m2 in enumerate(models):\n",
    "        if i == j:\n",
    "            p_values[i, j] = 1.0\n",
    "        else:\n",
    "            x = df[df['model'] == m1]['pde'].values\n",
    "            y = df[df['model'] == m2]['pde'].values\n",
    "            _, p_val = stats.ttest_rel(x, y)\n",
    "            p_values[i, j] = p_val\n",
    "\n",
    "log_pvals = -np.log10(p_values + 1e-300)\n",
    "\n",
    "fig, ax = plt.subplots(figsize=(8, 6))\n",
    "mask = np.triu(np.ones_like(p_values, dtype=bool), k=1)\n",
    "\n",
    "sns.heatmap(log_pvals, annot=True, fmt='.2f', cmap='YlOrRd',\n",
    "            xticklabels=models, yticklabels=models,\n",
    "            cbar_kws={'label': '-log10(p-value)'},\n",
    "            linewidths=0.5, linecolor='gray', ax=ax,\n",
    "            annot_kws={"size": 11, "weight": "bold"})\n",
    "\n",
    "# Add significance markers\n",
    "for i in range(n_models):\n",
    "    for j in range(n_models):\n",
    "        if i != j and not mask[i, j]:\n",
    "            if p_values[i, j] < 0.001:\n",
    "                sig = '***'\n",
    "            elif p_values[i, j] < 0.01:\n",
    "                sig = '**'\n",
    "            elif p_values[i, j] < 0.05:\n",
    "                sig = '*'\n",
    "            else:\n",
    "                sig = 'ns'\n",
    "            ax.text(j+0.5, i+0.75, sig, ha='center', va='center',\n",
    "                   color='white' if log_pvals[i,j] > 2 else 'black', \
",
    "                   fontsize=9, weight='bold')\n",
    "\n",
    "ax.set_title('Figure 3: Pairwise Statistical Significance Heatmap (PDE)\nPaired t-test, N=1000',\n",
    "             fontsize=13, fontweight='bold', pad=15)\n",
    "plt.tight_layout()\n",
    "plt.savefig('../figures/figure3_heatmap.pdf', bbox_inches='tight')\n",
    "plt.savefig('../figures/figure3_heatmap.png', dpi=300, bbox_inches='tight')\n",
    "plt.show()"
   ]
  }
 ],
