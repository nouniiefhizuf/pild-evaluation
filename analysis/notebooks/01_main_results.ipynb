   "source": [
    "# 01: Main Results Reproduction\n",
    "\n",
    "This notebook reproduces Table 1 and Figure 2 from the paper.\n",
    "\n",
    "**Paper:** Beyond Pixel-Pushing: Evaluating LLMs as Actionable Physics Simulators\n",
    "**Authors:** Soltani et al., NeurIPS 2026"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import numpy as np\n",
    "import pandas as pd\n",
    "import matplotlib.pyplot as plt\n",
    "import seaborn as sns\n",
    "from pathlib import Path\n",
    "\n",
    "# Set style\n",
    "sns.set_style('whitegrid')\n",
    "plt.rcParams['figure.dpi'] = 300\n",
    "\n",
    "# Load results\n",
    "results_dir = Path('../../results')\n",
    "models = ['gpt-4o', 'llama-3.3-70b', 'qwen2.5-72b', 'deepseek-v3']\n",
    "\n",
    "# Aggregate metrics\n",
    "data = []\n",
    "for model in models:\n",
    "    model_dir = results_dir / model\n",
    "    # Load all JSON results\n",
    "    for json_file in model_dir.glob('*.json'):\n",
    "        with open(json_file) as f:\n",
    "            result = json.load(f)\n",
    "        data.append({\n",
    "            'model': model,\n",
    "            'pde': result['metrics']['pde'],\n",
    "            'execution_rate': result['metrics']['execution_rate'],\n",
    "            'rouge_l': result['metrics']['rouge_l'],\n",
    "            'bertscore': result['metrics']['bertscore'],\n",
    "            'pass_at_1': result['metrics']['pass_at_1']\n",
    "        })\n",
    "\n",
    "df = pd.DataFrame(data)\n",
    "print(f\"Loaded {len(df)} results\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Table 1: Main Results\n",
    "summary = df.groupby('model').agg({\n",
    "    'pde': ['mean', 'std'],\n",
    "    'execution_rate': ['mean', 'std'],\n",
    "    'rouge_l': ['mean', 'std'],\n",
    "    'bertscore': ['mean', 'std'],\n",
    "    'pass_at_1': 'mean'\n",
    "}).round(4)\n",
    "\n",
    "print(\"Table 1: Main Results\")\n",
    "print(summary)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Figure 2: Performance Comparison\n",
    "fig, axes = plt.subplots(2, 2, figsize=(10, 8))\n",
    "\n",
    "metrics = ['pde', 'execution_rate', 'rouge_l', 'bertscore']\n",
    "titles = ['Physical Deviation Error (↓)', 'Execution Rate (↑)', \
",
    "          'ROUGE-L (↑)', 'BERTScore (↑)']\n",
    "colors = ['#e74c3c', '#3498db', '#2ecc71', '#9b59b6']\n",
    "\n",
    "for idx, (ax, metric, title, color) in enumerate(zip(axes.flat, metrics, titles, colors)):\n",
    "    means = df.groupby('model')[metric].mean()\n",
    "    stds = df.groupby('model')[metric].std()\n",
    "    \n",
    "    bars = ax.bar(means.index, means.values, yerr=stds.values, \
",
    "                  capsize=5, color=color, alpha=0.8, edgecolor='black')\n",
    "    ax.set_ylabel(title, fontsize=10)\n",
    "    ax.set_ylim(0, 1.0 if metric != 'pde' else 0.5)\n",
    "    ax.grid(axis='y', alpha=0.3)\n",
    "    \n",
    "    for bar, mean in zip(bars, means):\n",
    "        height = bar.get_height()\n",
    "        ax.text(bar.get_x() + bar.get_width()/2., height + 0.01,\n",
    "                f'{mean:.3f}', ha='center', va='bottom', fontsize=9)\n",
    "\n",
    "plt.suptitle('Figure 2: Model Performance Across Evaluation Metrics', \
",
    "             fontsize=14, fontweight='bold')\n",
    "plt.tight_layout()\n",
    "plt.savefig('../figures/figure2_performance.pdf', bbox_inches='tight')\n",
    "plt.savefig('../figures/figure2_performance.png', dpi=300, bbox_inches='tight')\n",
    "plt.show()"
   ]
  }
 ],
